# ==========================================
# LLM PROVIDER TOGGLE
# Choose either 'ollama' or 'openai'
# ==========================================
LLM_PROVIDER=ollama

# ------------------------------------------
# IF LLM_PROVIDER=ollama
# ------------------------------------------
# Use host.docker.internal if Ollama is running on your host machine
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama
OLLAMA_MODEL_NAME=openai/gpt-oss:120b-cloud

# ------------------------------------------
# IF LLM_PROVIDER=openai
# ------------------------------------------
# Uncomment these lines and add your OpenAI API Key
# OPENAI_BASE_URL=
# OPENAI_API_KEY=sk-your-actual-chatgpt-key-here
# OPENAI_MODEL_NAME=gpt-4o

# ==========================================
# SWIGGY INSTAMART CONFIGURATION
# ==========================================
# Add your token to enable Swiggy toolsets in the Chef Agent
SWIGGY_ACCESS_TOKEN=
